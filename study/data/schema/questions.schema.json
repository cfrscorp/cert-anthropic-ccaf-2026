{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCAF practice questions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "domain", "task_statement", "stem", "options", "correct", "rationale", "difficulty"],
    "properties": {
      "id": { "type": "string", "pattern": "^q-[1-5]\\.[0-9]+-[0-9]{3}$" },
      "domain": { "type": "integer", "minimum": 1, "maximum": 5 },
      "task_statement": { "type": "string", "pattern": "^[1-5]\\.[0-9]+$" },
      "scenario": { "type": ["string", "null"] },
      "stem": { "type": "string", "minLength": 10 },
      "options": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "text"],
          "properties": {
            "key": { "enum": ["A", "B", "C", "D"] },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      },
      "correct": { "enum": ["A", "B", "C", "D"] },
      "rationale": {
        "type": "object",
        "additionalProperties": false,
        "required": ["correct", "distractors"],
        "properties": {
          "correct": { "type": "string", "minLength": 1 },
          "distractors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "A": { "type": "string", "minLength": 1 },
              "B": { "type": "string", "minLength": 1 },
              "C": { "type": "string", "minLength": 1 },
              "D": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "lab": { "type": ["string", "null"], "pattern": "^lab-[0-9]{2}-" },
      "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
      "tags": { "type": "array", "items": { "type": "string" } }
    }
  }
}
