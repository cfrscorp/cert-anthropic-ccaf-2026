{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCAF data set manifest",
  "description": "Lists the question-set and flashcard-set files the Web UI's set picker offers, so new tiers/sets don't need code changes to surface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "flashcards"],
  "properties": {
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "flashcards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "file"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.json$" }
      }
    }
  }
}
