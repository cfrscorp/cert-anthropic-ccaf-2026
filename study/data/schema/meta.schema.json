{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCAF study metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["domains", "task_statements", "config"],
  "properties": {
    "domains": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weight"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 5 },
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "task_statements": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "title", "labs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[1-5]\\.[0-9]+$" },
          "domain": { "type": "integer", "minimum": 1, "maximum": 5 },
          "title": { "type": "string", "minLength": 1 },
          "labs": { "type": "array", "items": { "type": "string", "pattern": "^lab-[0-9]{2}-" } }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions_per_task_target"],
      "properties": {
        "questions_per_task_target": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
